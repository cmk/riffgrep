#!/usr/bin/env bash
# .githooks/pre-commit - git-side pre-commit gate (cheap checks).

set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

step() {
  printf 'pre-commit: %s\n' "$*"
}

step "cargo fmt"
cargo fmt --all -- --check
step "scripts/check_pii.sh"
scripts/check_pii.sh

step "OK"
